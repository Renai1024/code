            (#{item.department},
            #{item.name},
            #{item.empNo},
            #{item.businessUnit},
            #{item.projectCode},
            #{item.asRole},
            #{item.onTimeCount},
            #{item.overdueCompletedCount},
            #{item.pendingCount},
            #{item.overdueUncompletedCount},
            #{item.totalTasks})
        </foreach>
    </insert>



