<mapper namespace="com.miracle.extra.mapper.PlmProjectMapper">

    <resultMap type="PlmProject" id="PlmProjectResult">
        <result property="id"    column="id"    />
        <result property="projectNumber"    column="projectNumber"    />
        <result property="projectName"    column="projectName"    />
        <result property="businessDivision"    column="businessDivision"    />
        <result property="projectPlanStartTime"    column="projectPlanStartTime"  jdbcType="TIMESTAMP"  />
        <result property="projectActualStartTime"    column="projectActualStartTime"  jdbcType="TIMESTAMP"  />
        <result property="projectActualEndTime"    column="projectActualEndTime"  jdbcType="TIMESTAMP"  />
        <result property="projectState"    column="projectState"    />
        <result property="projectManager"    column="projectManager"    />
        <result property="projectCompletedOnScheduleCount"    column="projectCompletedOnScheduleCount" />
        <result property="projectMark"    column="projectMark"    />
        <result property="rdEngineer"    column="rdEngineer"    />
        <result property="rdEngineerId"    column="rdEngineerId"    />
        <result property="projectPlanEndTime"    column="projectPlanEndTime"  jdbcType="TIMESTAMP"  />
        <result property="massProductionTime"    column="massProductionTime"  jdbcType="TIMESTAMP"  />
        <result property="completeTaskCount"    column="completeTaskCount"    />
        <result property="overdueTaskCount"    column="overdueTaskCount"    />
        <result property="pendingTaskCount"    column="pendingTaskCount"    />
        <result property="completeUnfinishedTaskCount"    column="completeUnfinishedTaskCount"    />
        <result property="taskCount"    column="taskCount"    />
        <result property="projectManagerId"    column="projectManagerId"    />
    </resultMap>


    <resultMap type="PlmProjectEmployee" id="PlmProjectEmployeeResult">
        <result property="id"    column="id"    />
        <result property="department"    column="department"    />
        <result property="name"    column="name"    />
        <result property="empNo"    column="emp_no"    />
        <result property="businessUnit"    column="business_unit"   />
        <result property="projectCode"    column="project_code"   />
        <result property="asRole"    column="as_role"  />
        <result property="onTimeCount"    column="on_time_count"  />
        <result property="overdueCompletedCount"    column="overdue_completed_count"    />
        <result property="pendingCount"    column="pending_count"    />
        <result property="overdueUncompletedCount"    column="overdue_uncompleted_count"    />
        <result property="totalTasks"    column="total_tasks"    />
    </resultMap>

    <sql id="selectPlmProjectVo">
        select id, projectNumber,
               projectName,
               businessDivision,
               projectPlanStartTime,
               projectActualStartTime,
               projectActualEndTime,
               projectState,
               projectManager,
               projectCompletedOnScheduleCount,
               projectMark,
               rdEngineer,
               rdEngineerId,
               projectPlanEndTime,
               massProductionTime,
               completeTaskCount,
               overdueTaskCount,
               pendingTaskCount,
               completeUnfinishedTaskCount,
               taskCount,
               projectManagerId
               from plm_project
    </sql>

    <select id="selectPlmProjectList" parameterType="PlmProject" resultMap="PlmProjectResult">
        <include refid="selectPlmProjectVo"/>
        <where>
            <if test="projectNumber != null  and projectNumber != ''"> and projectNumber = #{projectNumber}</if>
            <if test="projectName != null  and projectName != ''"> and projectName like concat('%', #{projectName}, '%')</if>
            <if test="businessDivision != null  and businessDivision != ''"> and businessDivision = #{businessDivision}</if>
            <if test="projectPlanStartTime != null "> and projectPlanStartTime &gt;= #{projectPlanStartTime} and projectPlanStartTime &lt; DATE_ADD(#{projectPlanStartTime}, interval 1 day)</if>
            <if test="projectActualStartTime != null "> and projectActualStartTime &gt;= #{projectActualStartTime} and projectActualStartTime &lt; DATE_ADD(#{projectActualStartTime}, interval 1 day)</if>
            <if test="projectActualEndTime != null "> and projectActualEndTime &gt;= #{projectActualEndTime} and projectActualEndTime &lt; DATE_ADD(#{projectActualEndTime}, interval 1 day)</if>
            <if test="projectState != null  and projectState != ''"> and projectState = #{projectState}</if>
            <if test="projectManager != null  and projectManager != ''"> and projectManager = #{projectManager}</if>
            <if test="projectCompletedOnScheduleCount != null  and projectCompletedOnScheduleCount != ''"> and projectCompletedOnScheduleCount = #{projectCompletedOnScheduleCount}</if>
             <if test="projectMark != null  and projectMark != ''"> and projectMark = #{projectMark}</if>
        </where>
    </select>

    <select id="selectPlmProjectById" parameterType="Long" resultMap="PlmProjectResult">
        <include refid="selectPlmProjectVo"/>
        where id = #{id}
    </select>

    <insert id="insertPlmProject" parameterType="PlmProject" useGeneratedKeys="true" keyProperty="id">
        insert into plm_project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectNumber != null">projectNumber,</if>
            <if test="projectName != null">projectName,</if>
            <if test="businessDivision != null">businessDivision,</if>
            <if test="projectPlanStartTime != null">projectPlanStartTime,</if>
            <if test="projectActualStartTime != null">projectActualStartTime,</if>
            <if test="projectActualEndTime != null">projectActualEndTime,</if>
            <if test="projectState != null">projectState,</if>
            <if test="projectManager != null">projectManager,</if>
            <if test="projectCompletedOnScheduleCount != null">projectCompletedOnScheduleCount,</if>
            <if test="projectMark != null">projectMark,</if>
            <if test="rdEngineer != null">rdEngineer,</if>
            <if test="rdEngineerId != null">rdEngineerId,</if>
            <if test="projectPlanEndTime != null">projectPlanEndTime,</if>
            <if test="massProductionTime != null">massProductionTime,</if>
            <if test="completeTaskCount != null">completeTaskCount,</if>
            <if test="overdueTaskCount != null">overdueTaskCount,</if>
            <if test="pendingTaskCount != null">pendingTaskCount,</if>
            <if test="completeUnfinishedTaskCount != null">completeUnfinishedTaskCount,</if>
            <if test="taskCount != null">taskCount,</if>
            <if test="projectManagerId != null">projectManagerId,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectNumber != null">#{projectNumber},</if>
            <if test="projectName != null">#{projectName},</if>
            <if test="businessDivision != null">#{businessDivision},</if>
            <if test="projectPlanStartTime != null">#{projectPlanStartTime},</if>
            <if test="projectActualStartTime != null">#{projectActualStartTime},</if>
            <if test="projectActualEndTime != null">#{projectActualEndTime},</if>
            <if test="projectState != null">#{projectState},</if>
            <if test="projectManager != null">#{projectManager},</if>
            <if test="projectCompletedOnScheduleCount != null">#{projectCompletedOnScheduleCount},</if>
            <if test="projectMark != null">#{projectMark},</if>
            <if test="rdEngineer != null">#{rdEngineer},</if>
            <if test="rdEngineerId != null">#{rdEngineerId},</if>
            <if test="projectPlanEndTime != null">#{projectPlanEndTime},</if>
            <if test="massProductionTime != null">#{massProductionTime},</if>
            <if test="completeTaskCount != null">#{completeTaskCount},</if>
            <if test="overdueTaskCount != null">#{overdueTaskCount},</if>
            <if test="pendingTaskCount != null">#{pendingTaskCount},</if>
            <if test="completeUnfinishedTaskCount != null">#{completeUnfinishedTaskCount},</if>
            <if test="taskCount != null">#{taskCount},</if>
            <if test="projectManagerId != null">#{projectManagerId},</if>
         </trim>
    </insert>

    <insert id="insertPlmProjectEmployee" parameterType="PlmProjectEmployee" useGeneratedKeys="true" keyProperty="id">
        insert into plm_project_employee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="department != null">department,</if>
            <if test="name != null">name,</if>
            <if test="empNo != null">emp_no,</if>
            <if test="businessUnit != null">business_unit,</if>
            <if test="projectCode != null">project_code,</if>
            <if test="asRole != null">as_role,</if>
            <if test="onTimeCount != null">on_time_count,</if>
            <if test="overdueCompletedCount != null">overdue_completed_count,</if>
            <if test="pendingCount != null">pending_count,</if>
            <if test="overdueUncompletedCount != null">overdue_uncompleted_count,</if>
            <if test="totalTasks != null">total_tasks,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="department != null">#{department},</if>
            <if test="name != null">#{name},</if>
            <if test="empNo != null">#{emp_no},</if>
            <if test="businessUnit != null">#{business_unit},</if>
            <if test="projectCode != null">#{project_code},</if>
            <if test="asRole != null">#{as_role},</if>
            <if test="onTimeCount != null">#{on_time_count},</if>
            <if test="overdueCompletedCount != null">#{overdue_completed_count},</if>
            <if test="pendingCount != null">#{pending_count},</if>
            <if test="overdueUncompletedCount != null">#{overdue_uncompleted_count},</if>
            <if test="totalTasks != null">#{total_tasks},</if>
        </trim>
    </insert>


    <!-- 批量插入 -->
    <insert id="insertPlmProjectBatch" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO plm_project
        (projectNumber,
         projectName,
         businessDivision,
         projectPlanStartTime,
         projectActualStartTime,
         projectActualEndTime,
         projectState,
         projectManager,
         projectCompletedOnScheduleCount,
         projectMark,
        rdEngineer,
        rdEngineerId,
        projectPlanEndTime,
        massProductionTime,
        completeTaskCount,
        overdueTaskCount,
        pendingTaskCount,
        completeUnfinishedTaskCount,
        taskCount,
        projectManagerId)
        values
        <foreach collection="plmProjectList" item="item" separator=",">
            (#{item.projectNumber},
            #{item.projectName},
            #{item.businessDivision},
            #{item.projectPlanStartTime,jdbcType=TIMESTAMP},
            #{item.projectActualStartTime,jdbcType=TIMESTAMP},
            #{item.projectActualEndTime,jdbcType=TIMESTAMP},
            #{item.projectState},
            #{item.projectManager},
            #{item.projectCompletedOnScheduleCount},
            #{item.projectMark},
            #{item.rdEngineer},
            #{item.rdEngineerId},
            #{item.projectPlanEndTime,jdbcType=TIMESTAMP},
            #{item.massProductionTime,jdbcType=TIMESTAMP},
            #{item.completeTaskCount},
            #{item.overdueTaskCount},
            #{item.pendingTaskCount},
            #{item.completeUnfinishedTaskCount},
            #{item.taskCount},
            #{item.projectManagerId})
        </foreach>
    </insert>

    <!-- 用户维度plm项目批量插入 -->
