        <include refid="selectMesChuXinDuanZiHanReportVo"/>
        <where>
            <if test="batchNo != null and batchNo != ''">
                AND batchNo LIKE CONCAT('%', #{batchNo}, '%')
            </if>
            <if test="productCode != null and productCode != ''">
                AND productCode LIKE CONCAT('%', #{productCode}, '%')
            </if>
            <if test="equipmentNumber != null and equipmentNumber != ''">
                AND equipmentNumber LIKE CONCAT('%', #{equipmentNumber}, '%')
            </if>
            <if test="alarmStatus != null and alarmStatus != ''">
                AND alarmStatus LIKE CONCAT('%', #{alarmStatus}, '%')
            </if>
            <if test="createStartTime != null">
                AND CreateTime &gt;= #{createStartTime}
            </if>
            <if test="createEndTime != null">
                AND CreateTime &lt;= #{createEndTime}
            </if>
        </where>
        order by CreateTime desc
