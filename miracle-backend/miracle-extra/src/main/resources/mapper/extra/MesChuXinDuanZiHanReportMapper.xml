    <sql id="selectMesChuXinDuanZiHanReportVo">
        SELECT
        Id AS id,
        CreateTime AS createtime,
        batchNo AS batchno,
        productionTime AS productiontime,
        productCode AS productcode,
        weldingTime AS weldingtime,
        weldingAmplitude AS weldingamplitude,
        weldingPressure AS weldingpressure,
        weldingEnergy AS weldingenergy,
        weldingPower AS weldingpower,
        preloadingHeight AS preloadingheight,
        postWeldingHeight AS postweldingheight,
        weldingDepth AS weldingdepth,
