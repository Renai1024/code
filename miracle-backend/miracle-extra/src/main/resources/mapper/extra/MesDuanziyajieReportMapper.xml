        <result property="serialNumber" column="serialnumber"/>
        <result property="dateTime" column="datetime"/>
        <result property="proUniqueCode" column="prouniquecode"/>
        <result property="wireType" column="wiretype"/>
        <result property="pressureWeldingMode" column="pressureweldingmode"/>
        <result property="rivetingHeight" column="rivetingheight"/>
        <result property="rivetingCorrection" column="rivetingcorrection"/>
        <result property="preloadingTrip" column="preloadingtrip"/>
        <result property="locationLocation" column="locationlocation"/>
        <result property="holdingTime" column="holdingtime"/>
        <result property="startWay" column="startway"/>
        <result property="peakLoad" column="peakload"/>
        <result property="peakDeviation" column="peakdeviation"/>
        <result property="peakCrimpingLoad" column="peakcrimpingload"/>
        <result property="pressureMonitoringPeak" column="pressuremonitoringpeak"/>
        <result property="detectPatterns" column="detectpatterns"/>
        <result property="rivetingPressureSpeed" column="rivetingpressurespeed"/>
        <result property="toleranceNumber" column="tolerancenumber"/>
        <result property="cpk" column="cpk"/>
        <result property="security" column="security"/>
        <result property="peakRange" column="peakrange"/>
        <result property="peakJudgement" column="peakjudgement"/>
        <result property="areaRange" column="arearange"/>
        <result property="areaJudgement" column="areajudgement"/>
        <result property="offsetRange" column="offsetrange"/>
        <result property="offsetJudgement" column="offsetjudgement"/>
        <result property="lessCoreWireRange" column="lesscorewirerange"/>
        <result property="lessCoreWireJudgement" column="lesscorewirejudgement"/>
        <result property="samplingWindowWidth" column="samplingwindowwidth"/>
