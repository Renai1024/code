<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miracle.extra.mapper.MesDuanziyajieReportMapper">

    <resultMap type="MesDuanziyajieReport" id="MesDuanZiYaJieReportResult">
        <result property="id" column="id"/>
