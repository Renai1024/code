        <result property="applicationNo" column="applicationno"/>
        <result property="equipmentNo" column="equipmentno"/>
        <result property="createdAt" column="createdat"/>
    </resultMap>

    <sql id="selectMesReportDuanZiYaJieVo">
        SELECT
        Id AS id,
        "No" AS no,
        SerialNumber AS serialnumber,
        "DateTime" AS datetime,
        ProUniqueCode AS prouniquecode,
        WireType AS wiretype,
        PressureWeldingMode AS pressureweldingmode,
        RivetingHeight AS rivetingheight,
        RivetingCorrection AS rivetingcorrection,
        PreloadingTrip AS preloadingtrip,
        LocationLocation AS locationlocation,
        HoldingTime AS holdingtime,
        StartWay AS startway,
        PeakLoad AS peakload,
        PeakDeviation AS peakdeviation,
        PeakCrimpingLoad AS peakcrimpingload,
        PressureMonitoringPeak AS pressuremonitoringpeak,
        DetectPatterns AS detectpatterns,
        RivetingPressureSpeed AS rivetingpressurespeed,
        ToleranceNumber AS tolerancenumber,
        Cpk AS cpk,
        Security AS security,
        PeakRange AS peakrange,
        PeakJudgement AS peakjudgement,
        AreaRange AS arearange,
        AreaJudgement AS areajudgement,
        OffsetRange AS offsetrange,
        OffsetJudgement AS offsetjudgement,
        LessCoreWireRange AS lesscorewirerange,
        LessCoreWireJudgement AS lesscorewirejudgement,
        SamplingWindowWidth AS samplingwindowwidth,
        Result AS result,
        Operators AS operators,
        Administrator AS administrator,
        ApplicationNo AS applicationno,
        EquipmentNo AS equipmentno,
        CreatedAt AS createdat
        FROM dbo.DuanZiYaJieRecord
    </sql>

    <select id="selectMesDuanziyajieReportList" parameterType="MesDuanziyajieReport" resultMap="MesDuanZiYaJieReportResult">
        <include refid="selectMesReportDuanZiYaJieVo"/>
        <where>
            <if test="proUniqueCode != null and proUniqueCode != ''">
                AND ProUniqueCode LIKE CONCAT('%', #{proUniqueCode}, '%')
            </if>
            <if test="wireType != null and wireType != ''">
                AND WireType LIKE CONCAT('%', #{wireType}, '%')
            </if>
            <if test="equipmentNo != null and equipmentNo != ''">
                AND EquipmentNo LIKE CONCAT('%', #{equipmentNo}, '%')
            </if>
            <if test="result != null and result != ''">
                AND Result = #{result}
            </if>
            <if test="testStartTime != null">
                AND "DateTime" &gt;= #{testStartTime}
            </if>
            <if test="testEndTime != null">
                AND "DateTime" &lt;= #{testEndTime}
            </if>
        </where>
        order by "DateTime" desc
    </select>

</mapper>