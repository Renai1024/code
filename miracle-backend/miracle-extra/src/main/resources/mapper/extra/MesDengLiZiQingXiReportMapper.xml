<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miracle.extra.mapper.MesDengLiZiQingXiReportMapper">

    <resultMap type="com.miracle.extra.domain.MesDengLiZiQingXiReport" id="MesDengLiZiQingXiReportResult">
        <id property="id" column="Id" />
        <result property="createTime" column="CreateTime" />
        <result property="sn1" column="sn1" />
        <result property="sn2" column="sn2" />
        <result property="rs" column="Rs" />
        <result property="lys" column="LYs" />
        <result property="rys" column="RYs" />
        <result property="xs" column="Xs" />
        <result property="zs" column="Zs" />
        <result property="height" column="height" />
        <result property="angle" column="angle" />
        <result property="tap" column="tap" />
        <result property="tTime" column="t_time" />
    </resultMap>

    <sql id="selectMesDengLiZiQingXiReportVo">
        select Id, CreateTime, sn1, sn2, Rs, LYs, RYs, Xs, Zs, height, angle, tap, t_time
        from DengLiZiQingXi
    </sql>

    <select id="selectMesDengLiZiQingXiReportList" parameterType="com.miracle.extra.domain.MesDengLiZiQingXiReport" resultMap="MesDengLiZiQingXiReportResult">
        <include refid="selectMesDengLiZiQingXiReportVo" />
        <where>
            <if test="sn1 != null and sn1 != ''">AND sn1 LIKE CONCAT('%', #{sn1}, '%')</if>
            <if test="sn2 != null and sn2 != ''">AND sn2 LIKE CONCAT('%', #{sn2}, '%')</if>
            <if test="rs != null and rs != ''">AND Rs LIKE CONCAT('%', #{rs}, '%')</if>
            <if test="lys != null and lys != ''">AND LYs LIKE CONCAT('%', #{lys}, '%')</if>
            <if test="rys != null and rys != ''">AND RYs LIKE CONCAT('%', #{rys}, '%')</if>
            <if test="xs != null and xs != ''">AND Xs LIKE CONCAT('%', #{xs}, '%')</if>
            <if test="zs != null and zs != ''">AND Zs LIKE CONCAT('%', #{zs}, '%')</if>
            <if test="height != null and height != ''">AND height LIKE CONCAT('%', #{height}, '%')</if>
            <if test="angle != null and angle != ''">AND angle LIKE CONCAT('%', #{angle}, '%')</if>
            <if test="tap != null and tap != ''">AND tap LIKE CONCAT('%', #{tap}, '%')</if>
            <if test="createStartTime != null">AND t_time &gt;= #{createStartTime}</if>
            <if test="createEndTime != null">AND t_time &lt;= #{createEndTime}</if>
        </where>
        order by CreateTime desc
    </select>

</mapper>